{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "customConditions": ["react-native-strict-api", "source"],
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "Bundler",
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../@types/*.d.ts"]
}
