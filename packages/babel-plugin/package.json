{
  "name": "@react-universal/babel-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "run -T tsdown src/index.ts"
  },
  "dependencies": {
    "@emotion/serialize": "^1.3.3",
    "@react-universal/core": "workspace:*",
    "lilconfig": "^3.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/types": "^7.28.5",
    "babel-plugin-tester": "^12.0.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/types": "^7.0.0"
  }
}
